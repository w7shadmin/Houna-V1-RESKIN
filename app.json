{
  "expo": {
    "name": "Houna",
    "slug": "houna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "houna",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EFF0EE"
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-audio",
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
